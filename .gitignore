# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*.pyd

# =========================
# Virtual environments
# =========================
.venv/
venv/
env/

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/

# =========================
# VS Code
# =========================
.vscode/

# =========================
# Local data
# =========================
data/local/*
!data/local/.gitkeep

# =========================
# Generated outputs
# =========================
outputs/descriptors/*
outputs/vocabularies/*
outputs/representations/*
outputs/rankings/*
outputs/metrics/*
outputs/figures/*

# Preserve output folders
!outputs/descriptors/.gitkeep
!outputs/vocabularies/.gitkeep
!outputs/representations/.gitkeep
!outputs/rankings/.gitkeep
!outputs/metrics/.gitkeep
!outputs/figures/.gitkeep

# Keep generated evaluation artifacts tracked
!outputs/metrics/
!outputs/metrics/*.json
!outputs/rankings/
!outputs/rankings/*.json
!outputs/representations/
!outputs/representations/*.json
!outputs/figures/
!outputs/figures/*.png

# =========================
# Image and media assets
# =========================
*.jpg
*.jpeg
*.png
*.bmp
*.gif
*.tif
*.tiff
*.webp
*.svg
data/downloads/*

# =========================
# Models / serialized data
# =========================
*.pkl
*.pickle
*.joblib
*.npy
*.npz

# =========================
# OS
# =========================
.DS_Store
Thumbs.db
